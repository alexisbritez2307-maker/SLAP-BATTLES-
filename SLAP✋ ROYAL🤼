-- Función dinámica para capturar partes del cuerpo
local function getTargetPart(character)
    return character:FindFirstChild("Right Arm") 
        or character:FindFirstChild("RightHand") 
        or character:FindFirstChild("HumanoidRootPart") 
        or character:FindFirstChild("Torso") 
        or character:FindFirstChild("UpperTorso")
end

local lastHitTimes = {}

-- Slap Aura general
task.spawn(function()
    local slapEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Slap")
    while true do
        task.wait(0.05)
        if slapAuraEnabled then
            pcall(function()
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local myPos = myChar.HumanoidRootPart.Position
                    local currentTime = tick()
                    
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            local targetPart = getTargetPart(p.Character)
                            
                            if hrp and targetPart and (hrp.Position - myPos).Magnitude <= 14 then
                                if not lastHitTimes[p] or (currentTime - lastHitTimes[p] >= 0.25) then
                                    lastHitTimes[p] = currentTime
                                    slapEvent:FireServer(targetPart)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
